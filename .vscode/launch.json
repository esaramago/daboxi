{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Daboxi + PocketBase",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "preLaunchTask": "Start PocketBase",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Daboxi + PocketBase (Concurrently)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev:all",
      "serverReadyAction": {
        "pattern": "- Local:.+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}